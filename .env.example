# Copy this file to ".env" and fill in your own values. Never commit ".env".

DJANGO_DEBUG=True
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kolkata

# Database: sqlite (default) or postgresql
DB_ENGINE=sqlite
# DB_NAME=customertrend
# DB_USER=
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

MAX_UPLOAD_SIZE_MB=100

# LLM settings (used from Phase 5). The key stays on the server only.
LLM_PROVIDER=anthropic
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30

# Accounts
ALLOW_REGISTRATION=True
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend   # for real password-reset emails
MAX_UPLOAD_ROWS=1000000
